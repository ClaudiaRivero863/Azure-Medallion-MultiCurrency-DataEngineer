{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-tpi-icaro"
		},
		"ls_blob_sttpiicaro_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_blob_sttpiicaro'"
		},
		"ls_databricks_tpi_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'ls_databricks_tpi'"
		},
		"ls_api_frankfurter_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.frankfurter.app"
		},
		"ls_databricks_tpi_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1004-223251-qof5rcex"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-tpi-icaro_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_blob_sttpiicaro_connectionString": {
						"value": "[parameters('ls_blob_sttpiicaro_connectionString')]"
					},
					"ls_databricks_tpi_accessToken": {
						"value": "[parameters('ls_databricks_tpi_accessToken')]"
					},
					"ls_api_frankfurter_properties_typeProperties_url": {
						"value": "[parameters('ls_api_frankfurter_properties_typeProperties_url')]"
					},
					"ls_databricks_tpi_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_databricks_tpi_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}